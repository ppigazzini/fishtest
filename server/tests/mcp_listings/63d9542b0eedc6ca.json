 {
  "annotations": {
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Return one page of finished runs, newest first, 50 to a page, optionally one user's, only those whose info holds some words, only the passed ones, only the yellow ones, only long time controls, only those last updated within a time window, or only those whose arch filter admits an architecture.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "arch": {
     "description": "Only the runs whose arch filter admits this architecture, searched as the scheduler searches a worker's: the runs whose arches hold it. A run that sets no arch filter admits every architecture and is left out. No index holds the filters, so a window bounds what is read",
     "enum": [
      "apple-silicon",
      "armv7",
      "armv7-neon",
      "armv8",
      "armv8-dotprod",
      "e2k",
      "general-32",
      "general-64",
      "loongarch64",
      "loongarch64-lasx",
      "loongarch64-lsx",
      "ppc-32",
      "ppc-64",
      "ppc-64-altivec",
      "ppc-64-vsx",
      "riscv64",
      "x86-32",
      "x86-32-sse2",
      "x86-32-sse41-popcnt",
      "x86-64",
      "x86-64-avx2",
      "x86-64-avx512",
      "x86-64-avxvnni",
      "x86-64-bmi2",
      "x86-64-sse3-popcnt",
      "x86-64-sse41-popcnt",
      "x86-64-ssse3",
      "x86-64-vnni512",
      "x86-64-avx512icl"
     ]
    },
    "ltc_only": {
     "description": "Only the runs whose base time control is at least 40 seconds",
     "type": "boolean"
    },
    "page": {
     "description": "The page, from 1, and 1 when absent; a page past the last holds no run",
     "minimum": 1,
     "type": "integer"
    },
    "since": {
     "description": "Only the runs last updated at or after this time: a UTC date, such as 2026-01-06, or a UTC time as a result writes it, such as 2026-11-20 20:48:11+00:00",
     "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])([ T]([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]{1,6})?)?(Z|\\+00:00)?)?$",
     "type": "string"
    },
    "success_only": {
     "description": "Only the green runs: an SPRT test accepted, or a fixed-games test whose likelihood of superiority is above 95%",
     "type": "boolean"
    },
    "text": {
     "description": "Words to search for in the runs' info, as the finished-runs page searches them: a run matches when it holds any of the words, whatever their case; a phrase in double quotes is matched as written, and a word after a minus excludes what holds it",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "until": {
     "description": "Only the runs last updated before this time: a UTC date, such as 2026-01-06, or a UTC time as a result writes it, such as 2026-11-20 20:48:11+00:00",
     "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])([ T]([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]{1,6})?)?(Z|\\+00:00)?)?$",
     "type": "string"
    },
    "username": {
     "description": "The author's username, matched whole and case-sensitively",
     "type": "string"
    },
    "yellow_only": {
     "description": "Only the yellow runs: a test rejected with more wins than losses",
     "type": "boolean"
    }
   },
   "type": "object"
  },
